#include "utils.h"

void led_off(void)
{
    HAL_GPIO_WritePin(LED_GPIO_Port, LED_Pin, GPIO_PIN_SET);
}

void led_on(void)
{
    HAL_GPIO_WritePin(LED_GPIO_Port, LED_Pin, GPIO_PIN_RESET);
}

void led_toggle(uint32_t delay_ms, uint8_t times)
{
    for (uint8_t i = 0; i < times; i++)
    {
        HAL_GPIO_TogglePin(LED_GPIO_Port, LED_Pin);
        HAL_Delay(delay_ms);
        HAL_GPIO_TogglePin(LED_GPIO_Port, LED_Pin);
        HAL_Delay(delay_ms);
    }
}


void Enter_Standby_RTC(uint32_t seconds)
{
    // 1. Enable Power Clock & Backup Access
    __HAL_RCC_PWR_CLK_ENABLE();
    HAL_PWR_EnableBkUpAccess();

    // 2. DISABLE the WKUP Pin (PA0) to prevent noise from waking us up
    HAL_PWR_DisableWakeUpPin(PWR_WAKEUP_PIN1);

    // 3. Wait for RTC Synchronization (CRITICAL for F103)
    // Loop until the RSF (Registers Synchronized Flag) is set.
    while (!(RTC->CRL & RTC_CRL_RSF));

    // 4. Get Current Counter Value
    // Read High bits, shift, then add Low bits
    uint32_t current_counter = (RTC->CNTH << 16) | RTC->CNTL;

    // 5. Set the Alarm
    RTC_AlarmTypeDef sAlarm = {0};
    sAlarm.Alarm = current_counter + seconds;

    // We must call SetAlarm_IT to enable the interrupt internally
    if (HAL_RTC_SetAlarm_IT(&hrtc, &sAlarm, RTC_FORMAT_BIN) != HAL_OK)
    {
        Error_Handler();
    }

    // 6. Clear All Wakeup Flags to be safe
    __HAL_PWR_CLEAR_FLAG(PWR_FLAG_WU);

    // --- FIX IS HERE: Changed RTC_FLAG_ALRF to RTC_FLAG_ALRAF ---
    __HAL_RTC_ALARM_CLEAR_FLAG(&hrtc, RTC_FLAG_ALRAF);

    // 7. Enter Standby Mode
    HAL_PWR_EnterSTANDBYMode();
}

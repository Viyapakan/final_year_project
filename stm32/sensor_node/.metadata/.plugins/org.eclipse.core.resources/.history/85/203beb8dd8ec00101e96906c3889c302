#include "utils.h"

void led_off(void)
{
    HAL_GPIO_WritePin(LED_GPIO_Port, LED_Pin, GPIO_PIN_SET);
}

void led_on(void)
{
    HAL_GPIO_WritePin(LED_GPIO_Port, LED_Pin, GPIO_PIN_RESET);
}

void led_toggle(uint32_t delay_ms, uint8_t times)
{
    for (uint8_t i = 0; i < times; i++)
    {
        HAL_GPIO_TogglePin(LED_GPIO_Port, LED_Pin);
        HAL_Delay(delay_ms);
        HAL_GPIO_TogglePin(LED_GPIO_Port, LED_Pin);
        HAL_Delay(delay_ms);
    }
}


/* Add this function near other user functions */
void Enter_Standby_RTC(uint32_t seconds) {
    // 1. Enable Power and Backup Interface clocks
    __HAL_RCC_PWR_CLK_ENABLE();
    __HAL_RCC_BKP_CLK_ENABLE();
    HAL_PWR_EnableBkUpAccess();

    // 2. Set the RTC Alarm
    // The F103 RTC is a simple counter. We read current, add delay, set alarm.
    RTC_AlarmTypeDef sAlarm = {0};
    RTC_TimeTypeDef sTime = {0};

    // Get current counter value
    uint32_t current_counter = RTC->CNTH << 16 | RTC->CNTL;
    uint32_t alarm_counter = current_counter + seconds;

    sAlarm.AlarmTime.Hours = 0; // Not used in F103 simple counter mode usually,
    sAlarm.AlarmTime.Minutes = 0; // but HAL structure requires it.
    sAlarm.AlarmTime.Seconds = 0;
    sAlarm.Alarm = alarm_counter; // This is what matters for F103

    // Configure the Alarm
    if (HAL_RTC_SetAlarm_IT(&hrtc, &sAlarm, RTC_FORMAT_BIN) != HAL_OK) {
        Error_Handler();
    }

    // 3. Clear the Wakeup Flag (WUF) so we can sleep again later
    __HAL_PWR_CLEAR_FLAG(PWR_FLAG_WU);

    // 4. Enter Standby Mode
    HAL_PWR_EnterSTANDBYMode();
}
